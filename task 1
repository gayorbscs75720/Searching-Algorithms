import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        String[] lostItems = {"Wallet", "Phone", "Keys", "Sunglasses", "Watch"};

        Scanner input = new Scanner(System.in);

        System.out.print("Enter the item name: ");
        String item = input.nextLine();

        boolean found = false;

        for (int i = 0; i < lostItems.length; i++) {
            if (lostItems[i].equalsIgnoreCase(item)) {
                found = true;
                break;
            }
        }

        if (found) {
            System.out.println("Item found! Please collect it from the desk.");
        } else {
            System.out.println("Item not found. Please check again later.");
        }

        input.close();
    }
}
